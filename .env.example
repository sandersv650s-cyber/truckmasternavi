# Supabase (browser-safe project values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# HERE browser key. Restrict this key to your own domains in the HERE portal.
# You may alternatively configure HERE_API_KEY as a server environment variable.
VITE_HERE_API_KEY=your-here-api-key

# Optional server-side aliases
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# HERE_API_KEY=your-here-api-key
